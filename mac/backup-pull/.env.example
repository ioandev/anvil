# backup-pull settings (pull.sh). Copy to .env, chmod 600. Never commit .env.

# What to fetch: bucket (nightly off-site backups, read-only key, safe anywhere), live (a fresh dump now, over SSH),
# or both.
SOURCE=bucket
# Where the copies go (default ~/${ANVIL_NAME}-backups).
#DEST=
# How long to keep copies here, in days. Monthly bucket folders are kept forever.
#DAILY_KEEP_DAYS=90
#LIVE_KEEP_DAYS=30

# Every file is encrypted to this age PUBLIC key as it arrives; nothing is stored in plaintext. Only the matching
# private key can read the copies: never put the private key on a backup machine. Install age first
# (Linux: package age; macOS: brew install age).
AGE_RECIPIENT=${ANVIL_AGE_RECIPIENT}

# --- bucket: a key that can only read and list the backup bucket (Scaleway IAM: ObjectStorageObjectsRead +
# ObjectStorageBucketsRead, no expiry). Can read and list the backups, nothing else.
BACKUP_BUCKET=${BACKUP_BUCKET}
PULL_S3_ACCESS_KEY=
PULL_S3_SECRET_KEY=

# --- live: the server's SSH key is root on the server: only on machines you'd trust with that.
SERVER=${ANVIL_SERVER_IP}
SSH_PORT=${ANVIL_SSH_PORT}
SSH_KEY=~/.ssh/id_ed25519_anvil
# The read-only dump user's password: ATLAS_BACKUP_PASSWORD in anvil.env.
ATLAS_BACKUP_PASSWORD=

# Optional: report failures to the server's error list.
STATUS_URL=https://status.${ANVIL_DOMAIN}
WEBHOOK_TOKEN=
