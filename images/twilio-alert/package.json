{
    "name": "twiliowebhook",
    "version": "1.0.0",
    "description": "Phones you through Twilio on alerts (/alert, for Alertmanager), watches a server from elsewhere (WATCH_URL), and handles Twilio SMS/voice webhooks",
    "main": "dist/server.js",
    "scripts": {
        "build": "tsc",
        "start": "node dist/server.js",
        "dev": "tsc && node --env-file=.env dist/server.js"
    },
    "dependencies": {
        "express": "^5.3.0",
        "twilio": "^5.13.1"
    },
    "engines": {
        "node": ">=22"
    },
    "devDependencies": {
        "@types/express": "^5.0.6",
        "@types/node": "^24.19.2",
        "typescript": "^5.9.3"
    }
}
