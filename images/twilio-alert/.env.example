# Twilio account (Console → Account Info): the Account SID (AC…) always; then either an API key (SK…) + its
# secret (preferred: revocable on its own) or the Auth Token. The Auth Token also validates incoming webhooks.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_AUTH_TOKEN=
# The Twilio number calls come from, and the number /alert and the watchdog call
TWILIO_PHONE_NUMBER=
ALERT_NUMBER=
# Password for /alert?password=… and /watchdog?password=…
SERVICE_PASSWORD=
# The pager: calls at these minutes after a problem starts, then every CALL_REPEAT_MINUTES until it's resolved
CALL_SCHEDULE_MINUTES=0,2,4,6,10,15,20,30,45,60
CALL_REPEAT_MINUTES=60
# With the autopilot (POST /autopilot) in front, a 5-minute grace: 5,7,9,11,15,20,25,35,50,65
# No calls in these hours (calls due then wait), in this time zone
QUIET_HOURS=03-09
QUIET_TIMEZONE=Europe/London
# Picking up (not voicemail) stops calls for this long
ACK_SNOOZE_MINUTES=60

# Watchdog (optional): pull this status URL every minute and call when the server is gone or says it's not ok
WATCH_URL=
WATCH_FAIL_MINUTES=10

# Twilio webhooks (optional): forward incoming calls here
FORWARD_TO_NUMBER=
