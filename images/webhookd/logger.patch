@@ -0,0 +1,41 @@
+package middleware
+
+import (
+	"net/http/httptest"
+	"strings"
+	"testing"
+)
+
+func TestRedactedURL(t *testing.T) {
+	t.Setenv("STATUS_CODE", "s3cret")
+	t.Setenv("WEBHOOK_TOKEN", "tok")
+	for in, want := range map[string]string{
+		"/overall":                      "/overall",
+		"/overall?code=s3cret":          "/overall?code=ok",
+		"/overall?code=guess":           "/overall?code=wrong",
+		"/changelog?code=s3cret&days=0": "/changelog?code=ok&days=0",
+		"/am_heartbeat?token=tok":       "/am_heartbeat?token=ok",
+		"/alert?password=x":             "/alert?password=set",
+	} {
+		got := redactedURL(httptest.NewRequest("GET", in, nil))
+		if got != want {
+			t.Errorf("%s: got %s, want %s", in, got, want)
+		}
+		if strings.Contains(got, "s3cret") || strings.Contains(got, "tok&") {
+			t.Errorf("%s: secret leaked: %s", in, got)
+		}
+	}
+}
+
+func TestRequestIPPrefersCloudflare(t *testing.T) {
+	r := httptest.NewRequest("GET", "/", nil)
+	r.Header.Set("X-Forwarded-For", "6.6.6.6, 10.42.0.7")
+	r.Header.Set("CF-Connecting-IP", "203.0.113.9")
+	if ip := getRequestIP(r); ip != "203.0.113.9" {
+		t.Errorf("got %s", ip)
+	}
+	r.Header.Del("CF-Connecting-IP")
+	if ip := getRequestIP(r); ip != "6.6.6.6" {
+		t.Errorf("fallback: got %s", ip)
+	}
+}
