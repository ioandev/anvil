+// Query parameters whose values are secrets. Their value is logged only as "ok" (equal to the expected value from
+// the environment), "wrong" or "set" (no expected value known), so attempts to guess them still show in the log.
+var secretParams = map[string]string{"code": "STATUS_CODE", "token": "WEBHOOK_TOKEN", "password": "SERVICE_PASSWORD"}
+
+func redactedURL(r *http.Request) string {
+	q := r.URL.Query()
+	if len(q) == 0 {
+		return r.URL.Path
+	}
+	parts := make([]string, 0, len(q))
+	for k, vs := range q {
+		v := strings.Join(vs, ",")
+		if envName, secret := secretParams[strings.ToLower(k)]; secret {
+			want := os.Getenv(envName)
+			switch {
+			case want == "":
+				v = "set"
+			case subtle.ConstantTimeCompare([]byte(v), []byte(want)) == 1:
+				v = "ok"
+			default:
+				v = "wrong"
+			}
+		} else if len(v) > 64 {
+			v = v[:64] + "…"
+		}
+		parts = append(parts, url.QueryEscape(k)+"="+url.QueryEscape(v))
+	}
+	sort.Strings(parts)
+	return r.URL.Path + "?" + strings.Join(parts, "&")
+}
