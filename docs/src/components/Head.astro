---
// Starlight's <head>, plus this page's Open Graph image (src/pages/og/, rendered at build time).
import Default from '@astrojs/starlight/components/Head.astro'
const entry = Astro.locals.starlightRoute.entry
const id = entry ? entry.id || 'index' : null   // the home page's id is ""; its card is og/index.png
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const image = id && id !== '404' && Astro.site ? new URL(`${base}/og/${id}.png`, Astro.site).href : null
---
<Default />
{image && (
  <>
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={Astro.locals.starlightRoute.entry.data.title} />
    <meta name="twitter:image" content={image} />
  </>
)}
