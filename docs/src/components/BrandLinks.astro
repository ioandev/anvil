---
// Header links of the brand overlay (src/brand/brand.json "links"), before Starlight's own social icons.
import fs from 'node:fs'
import Default from '@astrojs/starlight/components/SocialIcons.astro'
const brand = JSON.parse(fs.readFileSync('./src/brand/brand.json', 'utf8'))
---
{brand.links.map((l: { label: string; href: string }) => <a class="brand-link" href={l.href}>{l.label}</a>)}
<Default />
<style>
  .brand-link { color: var(--sl-color-gray-2); font-size: var(--sl-text-sm); text-decoration: none; white-space: nowrap; }
  .brand-link:hover { color: var(--sl-color-white); }
</style>
