---
// A small inline-SVG diagram renderer. Boxes, edges and labels use classes from src/styles/custom.css, which draw
// with Starlight's colour tokens, so every diagram follows the light/dark theme with no client-side JavaScript.
export interface Box {
  x: number
  y: number
  w: number
  h: number
  title: string
  lines?: string[]
  kind?: 'accent' | 'danger' | 'ok'
}
export interface Edge {
  d: string // SVG path
  kind?: 'accent' | 'danger' | 'dash'
  end?: boolean // arrow head at the end (default true)
}
export interface Label {
  x: number
  y: number
  text: string
  anchor?: 'start' | 'middle' | 'end'
  zone?: boolean
}
export interface Zone {
  x: number
  y: number
  w: number
  h: number
}
interface Props {
  id: string
  width: number
  height: number
  title: string
  desc: string
  caption?: string
  boxes: Box[]
  edges: Edge[]
  labels?: Label[]
  zones?: Zone[]
}
const { id, width, height, title, desc, caption, boxes, edges, labels = [], zones = [] } = Astro.props
const head = (k?: string) => `url(#${id}-${k === 'accent' ? 'ha' : k === 'danger' ? 'hd' : 'h'})`
---

<figure class="dg">
  <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-labelledby={`${id}-t ${id}-d`}>
    <title id={`${id}-t`}>{title}</title>
    <desc id={`${id}-d`}>{desc}</desc>
    <defs>
      <marker id={`${id}-h`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0,0 L10,5 L0,10 z" class="head"></path>
      </marker>
      <marker id={`${id}-ha`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0,0 L10,5 L0,10 z" class="head accent"></path>
      </marker>
      <marker id={`${id}-hd`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0,0 L10,5 L0,10 z" class="head danger"></path>
      </marker>
    </defs>
    {zones.map((z) => <rect class="zone" x={z.x} y={z.y} width={z.w} height={z.h} rx="12"></rect>)}
    {
      edges.map((e) => (
        <path class={`edge ${e.kind ?? ''}`} d={e.d} marker-end={e.end === false ? undefined : head(e.kind)}></path>
      ))
    }
    {
      boxes.map((b) => (
        <g>
          <rect class={`box ${b.kind ?? ''}`} x={b.x} y={b.y} width={b.w} height={b.h} rx="9"></rect>
          <text x={b.x + b.w / 2} y={b.y + 24} text-anchor="middle">
            {b.title}
          </text>
          {(b.lines ?? []).map((l, i) => (
            <text class="sub" x={b.x + b.w / 2} y={b.y + 44 + i * 17} text-anchor="middle">
              {l}
            </text>
          ))}
        </g>
      ))
    }
    {
      labels.map((l) => (
        <text class={l.zone ? 'zlbl' : 'lbl'} x={l.x} y={l.y} text-anchor={l.anchor ?? 'start'}>
          {l.text}
        </text>
      ))
    }
  </svg>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
