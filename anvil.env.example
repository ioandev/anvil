# anvil.env: every setting and secret of one anvil platform. Copy to anvil.env (gitignored), fill in the first part,
# then `scripts/anvil-secrets init` generates the second part and encrypts the file to anvil.env.sops (in git).
# Values here are placeholders. Never commit anvil.env itself.

# ---------------------------------------------------------------------------------------------------------------
# 1. You set these
# ---------------------------------------------------------------------------------------------------------------
ANVIL_NAME=anvil                      # server hostname and prefix of every cloud resource
ANVIL_DOMAIN=example.com              # a domain you own; becomes a Cloudflare zone (demo., status., www.)
ANVIL_REGION=fr-par                   # Scaleway region
ANVIL_ZONE=fr-par-1                   # Scaleway availability zone (inside the region)
ANVIL_INSTANCE_TYPE=DEV1-L            # 4 vCPU / 8 GB / 80 GB local SSD
ANVIL_SWAP_MB=2048                    # swapfile (MiB); resize a running server with scripts/node.sh swap <MiB>
ANVIL_TIMEZONE=Europe/London          # for quiet hours and post-mortem dates
ANVIL_QUIET_HOURS=03-07               # no phone calls between these hours (local time); they wait
ANVIL_OWNER_EMAIL=you@example.com     # backup failure emails, the Monday "backups OK"
ANVIL_OWNER_PHONE=+440000000000       # who gets phoned (E.164)

# Scaleway (console → IAM → API keys; create keys WITHOUT an expiry date)
SCW_ACCESS_KEY=SCWXXXXXXXXXXXXXXXXX
SCW_SECRET_KEY=00000000-0000-0000-0000-000000000000
SCW_DEFAULT_PROJECT_ID=00000000-0000-0000-0000-000000000000
SCW_DEFAULT_ORGANIZATION_ID=00000000-0000-0000-0000-000000000000

# Cloudflare (dashboard → My Profile → API Tokens). Scopes: Zone Read+Edit, DNS Edit, Zone Settings Edit,
# SSL and Certificates Edit, Cache Settings Edit, Cache Purge; all zones of the account. Never sent to the server.
CLOUDFLARE_API_TOKEN=
# Optional, a SECOND token that goes to the server: Zone Read + Cache Purge only, on your zone. Lets the edge-purger
# clear the cache when a site's content changes (sites.yaml purge_on_change); without it deploys still purge.
CLOUDFLARE_PURGE_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Namecheap (optional: lets the 20-cloudflare step switch nameservers for you; needs API access enabled and this
# machine's IP whitelisted). Leave empty to get the two nameservers to set by hand.
NAMECHEAP_API_USER=
NAMECHEAP_API_KEY=

# Tailscale (admin console → Settings → Keys: reusable, not ephemeral). The internal UIs live on the tailnet only.
TAILSCALE_AUTH_KEY=
ANVIL_TAILNET_HOST=anvil.tailnet-name.ts.net   # the server's MagicDNS name once it joined

# The home machine (an always-on Mac or Linux box on your tailnet: the watchdog, the autopilot, the vault)
ANVIL_HOME_SSH=you@home-machine              # ssh target for shipping compose files and images
ANVIL_HOME_TAILNET_HOST=home-machine.tailnet-name.ts.net
ANVIL_HOME_TAILNET_IP=100.64.0.2             # its tailnet IP (containers there can't resolve MagicDNS)
ANVIL_HOME_BAO_PORT=8200                # the home machine's vault port (tailnet); another platform on the same machine needs its own
ANVIL_HOME_WATCHDOG_PORT=3017           # the home watchdog's loopback port (its /pager); another platform on the same machine needs its own
ANVIL_REPO_URL=                        # git@github.com:<you>/<repo>.git: the autopilot clones it read-only for context (empty: no clone)
ANVIL_TAILNET_IP=100.64.0.1                  # the server's tailnet IP (same reason)

# Twilio (phone calls): account SID, an API key + secret, a voice-capable number
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_PHONE_NUMBER=

# Claude for the autopilot: an API key with a monthly spend limit (console.anthropic.com), or leave empty and set
# CLAUDE_CODE_OAUTH_TOKEN (`claude setup-token`, needs a Pro/Max subscription) instead.
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=

# ---------------------------------------------------------------------------------------------------------------
# 2. Generated (scripts/anvil-secrets init / the bootstrap steps). Don't type these.
# ---------------------------------------------------------------------------------------------------------------
ANVIL_SERVER_IP=203.0.113.10          # 30-infra: terraform output public_ip
ANVIL_CF_ZONE_ID=                     # 20-cloudflare: the zone's id
ANVIL_REGISTRY=rg.fr-par.scw.cloud/anvil-example   # 40-platform: the registry namespace
ANVIL_BACKUP_TAG=20260101-0000000     # image tags (scripts/image-tag), set when the images are built
ANVIL_TWILIO_TAG=20260101-0000000
ANVIL_DEMO_TAG=20260101-0000000
ANVIL_AUTOPILOT_TAG=20260101-0000000
ANVIL_WEBHOOKD_TAG=20260101-0000000
ANVIL_OPENBAO_BUCKET=anvil-openbao-example  # 70-autopilot: off-site vault snapshots (write-only key)
ANVIL_SSH_PORT=2222
ANVIL_AGE_RECIPIENT=age1examplepublickey  # your age public key (from ~/.config/sops/age/keys.txt)
ANVIL_SCW_PROJECT_ID=00000000-0000-0000-0000-000000000000  # = SCW_DEFAULT_PROJECT_ID (templates can only use ANVIL_ names)
STATUS_CODE=
WEBHOOK_TOKEN=
ALERT_SERVICE_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
ATLAS_ROOT_PASSWORD=
ATLAS_BACKUP_PASSWORD=
HEALTH_DB_PASSWORD=
BACKUP_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
# per project with a database (sites.yaml `db:`): <NS>_RW_PASSWORD / <NS>_RO_PASSWORD
ANVIL_DEMO_RW_PASSWORD=
ANVIL_DEMO_RO_PASSWORD=
