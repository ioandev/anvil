#!/usr/bin/env python3
"""Create and fill anvil's secrets (the 10-secrets bootstrap step). Idempotent: never changes a value that is set.

  scripts/anvil-secrets init     anvil.env from the example (if missing), an age key (if missing) + .sops.yaml,
                                 every generated value (passwords, codes, tokens), apps' `generate:` keys
                                 (sites.yaml) in apps/<ns>/prod.env; then encrypts everything (scripts/secrets.sh)
  scripts/anvil-secrets set K=V  set one value in anvil.env (e.g. ANVIL_SERVER_IP after terraform), then encrypt
  scripts/anvil-secrets missing  list the values you still have to type (empty or placeholder in part 1)

Never prints a secret value.
"""
import os, pathlib, re, secrets, shutil, string, subprocess, sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import anvil_env  # noqa: E402

REPO = anvil_env.REPO
os.chdir(REPO)
ENV, EXAMPLE = anvil_env.ENV_FILE, anvil_env.EXAMPLE
AGE_KEY = pathlib.Path(os.path.expanduser("~/.config/sops/age/keys.txt"))

# key -> generator. Codes that go in URLs are letters+digits; passwords are hex (safe in every config format).
ALNUM = string.ascii_letters + string.digits
GENERATED = {
    "STATUS_CODE": lambda: "".join(secrets.choice(ALNUM) for _ in range(24)),
    "WEBHOOK_TOKEN": lambda: secrets.token_hex(24),
    "ALERT_SERVICE_PASSWORD": lambda: secrets.token_hex(24),
    "GRAFANA_ADMIN_PASSWORD": lambda: secrets.token_hex(16),
    "ATLAS_ROOT_PASSWORD": lambda: secrets.token_hex(24),
    "ATLAS_BACKUP_PASSWORD": lambda: secrets.token_hex(24),
    "HEALTH_DB_PASSWORD": lambda: secrets.token_hex(24),
    "ATLAS_MONITOR_PASSWORD": lambda: secrets.token_hex(24),   # alerting-mysqld-exporter: replication status only
}
# Part 1 keys the person must type (the bootstrap checks them in 00-preflight).
REQUIRED = ["ANVIL_NAME", "ANVIL_DOMAIN", "ANVIL_REGION", "ANVIL_ZONE", "ANVIL_OWNER_EMAIL", "ANVIL_OWNER_PHONE",
            "SCW_ACCESS_KEY", "SCW_SECRET_KEY", "SCW_DEFAULT_PROJECT_ID", "SCW_DEFAULT_ORGANIZATION_ID",
            "CLOUDFLARE_API_TOKEN", "CLOUDFLARE_ACCOUNT_ID", "TAILSCALE_AUTH_KEY", "TWILIO_ACCOUNT_SID",
            "TWILIO_API_KEY", "TWILIO_API_SECRET", "TWILIO_PHONE_NUMBER"]
PLACEHOLDER = re.compile(r"^(|example\.com|you@example\.com|\+440000000000|SCWX+|0{8}-0{4}-0{4}-0{4}-0{12})$")


def set_value(path, key, value):
    """Set KEY=value in an env file, keeping comments and order (appends if absent)."""
    p = pathlib.Path(path)
    text = p.read_text() if p.exists() else ""
    line = f"{key}={value}"
    rx = re.compile(rf"^{re.escape(key)}=.*$", re.M)
    if rx.search(text):
        # keep a trailing "  # comment" if there is one
        text = rx.sub(lambda m: line + (("  #" + m.group(0).split(" #", 1)[1]) if " #" in m.group(0) else ""), text, 1)
    else:
        text += ("" if text.endswith("\n") or not text else "\n") + line + "\n"
    p.write_text(text)
    p.chmod(0o600)


def ensure_age_key():
    if not AGE_KEY.exists():
        if not shutil.which("age-keygen"):
            raise SystemExit("age-keygen not found: install age (00-preflight lists the tools)")
        AGE_KEY.parent.mkdir(parents=True, exist_ok=True)
        subprocess.run(["age-keygen", "-o", str(AGE_KEY)], check=True, capture_output=True)
        AGE_KEY.chmod(0o600)
        print(f"created an age key: {AGE_KEY}  <- SAVE A COPY IN YOUR PASSWORD MANAGER NOW (the only way to decrypt)")
    pub = next(l.split(":", 1)[1].strip() for l in AGE_KEY.read_text().splitlines() if l.startswith("# public key:"))
    sops_yaml = REPO / ".sops.yaml"
    want = f"# SOPS: everything is encrypted to this age public key (private key: {AGE_KEY}).\ncreation_rules:\n  - path_regex: \\.sops$\n    age: {pub}\n"
    if not sops_yaml.exists() or sops_yaml.read_text() != want:
        sops_yaml.write_text(want)
        print(".sops.yaml written for your age key")


def init():
    if not ENV.exists():
        shutil.copyfile(EXAMPLE, ENV)
        ENV.chmod(0o600)
        print("anvil.env created from anvil.env.example: fill in part 1 (scripts/anvil-secrets missing lists it)")
    ensure_age_key()
    env = anvil_env.parse(ENV)
    made = []
    for k, gen in GENERATED.items():
        if not env.get(k):
            set_value(ENV, k, gen()); made.append(k)
    import sites  # after anvil.env exists (sites.yaml expands from it)
    for ns, db in sites.dbs().items():
        key = ns.upper().replace("-", "_")
        for kind in ("RW", "RO"):
            k = f"{key}_{kind}_PASSWORD"
            if not env.get(k):
                set_value(ENV, k, secrets.token_hex(24)); made.append(k)
    # projects whose database can move (sites.yaml move:): the sync login and the moved server's root
    for ns in sites.moves():
        key = ns.upper().replace("-", "_")
        for k in (f"{key}_REPL_PASSWORD", f"{key}_DB_ROOT_PASSWORD"):
            if not env.get(k):
                set_value(ENV, k, secrets.token_hex(24)); made.append(k)
    for ns in sites.namespaces():
        keys = sites.generated(ns)
        if not keys:
            continue
        p = REPO / sites.nsdir(ns) / "prod.env"
        have = anvil_env.parse(p) if p.exists() else {}
        for k in keys:
            if not have.get(k):
                set_value(p, k, secrets.token_hex(24)); made.append(f"{ns}:{k}")
    # derived values the templates use (rendered as ${ANVIL_*})
    env = anvil_env.parse(ENV)
    pub = next(l.split(":", 1)[1].strip() for l in AGE_KEY.read_text().splitlines() if l.startswith("# public key:"))
    for k, v in (("ANVIL_AGE_RECIPIENT", pub), ("ANVIL_SCW_PROJECT_ID", env.get("SCW_DEFAULT_PROJECT_ID", ""))):
        if v and env.get(k) != v:
            set_value(ENV, k, v); made.append(k)
    print("generated: " + (", ".join(made) if made else "nothing new"))
    encrypt()
    left = missing()
    if left:
        print("still to fill in anvil.env: " + ", ".join(left))


def missing():
    env = anvil_env.parse(ENV) if ENV.exists() else {}
    out = [k for k in REQUIRED if PLACEHOLDER.match(env.get(k, ""))]
    if not env.get("ANTHROPIC_API_KEY") and not env.get("CLAUDE_CODE_OAUTH_TOKEN"):
        out.append("ANTHROPIC_API_KEY (or CLAUDE_CODE_OAUTH_TOKEN)")
    return out


def encrypt():
    if shutil.which("sops"):
        subprocess.run(["scripts/secrets.sh", "encrypt"], check=True)
    else:
        print("sops not installed: secrets NOT encrypted yet (install it, then `make secrets-encrypt`)")


def main(a):
    if a[:1] == ["init"]:
        init()
    elif a[:1] == ["set"] and len(a) == 2 and "=" in a[1]:
        k, v = a[1].split("=", 1)
        set_value(ENV, k, v); print(f"set {k}"); encrypt()
    elif a[:1] == ["missing"]:
        left = missing()
        print("\n".join(left) if left else "nothing missing")
        return 1 if left else 0
    else:
        print(__doc__); return 2
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
