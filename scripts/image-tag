#!/usr/bin/env bash
# Print the image tag for a build of a git checkout, the one convention for every image (the server's and the home machine's):
#
#   <YYYYMMDD>-<short sha>                 e.g. 20261027-83f3c56   (build date, UTC; the commit it was built from)
#   <YYYYMMDD>-<short sha>-<suffix>        a second build of the same clean commit on the same day (--suffix 2)
#   <YYYYMMDD>-<short sha>-dirty-<HHMMSS>  built with uncommitted changes (never mistaken for, or overwriting, a commit)
#
# Tags sort by date, name the exact source, and are never reused or moved (no :latest). Optionally also set the label
# app.kubernetes.io/version to the same value in the manifest.
#
#   scripts/image-tag [dir] [--suffix N]       dir defaults to the current directory
set -euo pipefail
dir=. suffix=
while [[ $# -gt 0 ]]; do
  case $1 in
    --suffix) suffix=${2:?--suffix needs a value}; shift 2 ;;
    -h|--help) sed -n '2,13p' "$0"; exit 0 ;;
    *) dir=$1; shift ;;
  esac
done
sha=$(git -C "$dir" rev-parse --short=7 HEAD)
tag="$(date -u +%Y%m%d)-$sha"
if [[ -n "$(git -C "$dir" status --porcelain --untracked-files=no -- .)" ]]; then
  tag+="-dirty-$(date -u +%H%M%S)"
elif [[ -n "$suffix" ]]; then
  tag+="-$suffix"
fi
echo "$tag"
