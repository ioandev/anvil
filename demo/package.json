{
  "name": "anvil-demo",
  "version": "1.0.0",
  "private": true,
  "description": "Tiny guestbook used to demo anvil: break it on stage, watch the alert fire and the autopilot fix it.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test --test-reporter=spec \"test/**/*.test.ts\"",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js"
  },
  "dependencies": {
    "fastify": "^5.12.7",
    "mysql2": "^3.24.6",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  }
}
